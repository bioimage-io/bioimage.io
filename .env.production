# Production build defaults.
#
# REACT_APP_CAMPAIGN_FIXTURES must be DEFINED here, not merely left unset.
#
# Create React App builds its DefinePlugin table from the REACT_APP_* variables
# that actually exist at build time. A variable that is unset gets no entry, so
# `process.env.REACT_APP_CAMPAIGN_FIXTURES === '1'` survives into the bundle as
# a runtime member access on the substituted process.env object literal, which
# webpack cannot statically fold. The dead branch then keeps its
# `await import('./__fixtures__/campaigns')` alive and the fixture chunk is
# emitted: unreachable, but still a served file full of invented figures.
#
# Defining it to "0" turns the comparison into `"0" === "1"`, webpack folds it,
# and the fixture module leaves the graph entirely. Verified by rebuilding and
# grepping build/static for a fixture site name.
#
# A staging build that deliberately wants the prototype data overrides this with
# `REACT_APP_CAMPAIGN_FIXTURES=1`, which also switches on the banner that says
# every figure on the page is illustrative.
REACT_APP_CAMPAIGN_FIXTURES=0
